                    "min": -2147483648,
                    "max": 2147483647,
                    "defaultData": 1,
                    "mandatory": false,
                    "description": "<p>The inductance between motor terminal and motor neutral point. It is equal to half of \"phase to phase inductance\" or \"line to line inductance\".</p>",
                    "inputType": "number",
