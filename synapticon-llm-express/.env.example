# ============================================
# LLM Configuration
# ============================================
# Choose one: LM Studio (development) or Ollama (production/deployment)

# === Option 1: LM Studio (GUI-based, good for development) ===
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_API_KEY=lm-studio
# LMSTUDIO_MODEL=meta-llama-3.1-8b-instruct

# === Option 2: Ollama (CLI-based, recommended for production) ===
# To set up Ollama:
# 1. Run: .\setup-ollama.ps1 (Windows)
# 2. Or manually: winget install Ollama.Ollama && ollama pull llama3.1:8b
# 3. See OLLAMA_SETUP.md for full instructions
LMSTUDIO_BASE_URL=http://localhost:11434/v1
LMSTUDIO_API_KEY=ollama
LMSTUDIO_MODEL=llama3.1:8b

# ============================================
# Server Configuration
# ============================================
PORT=3000

# ============================================
# MCP Server Configuration
# ============================================
# Motion Master Client MCP Server URL
MCP_SERVER_URL=http://localhost:8036

# ============================================
# External API Configuration (if needed)
# ============================================
EXT_API_BASE=http://localhost:4000
